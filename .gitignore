__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Data, weights, and run outputs are never committed.
# Anchored with a leading slash: a bare `data/` would also match the
# polyptail/data package and silently drop it from the commit.
/dataset/
/data/
/pretrained_pth/
/runs/
/results/
/result_map/
*.pth
*.pt
*.ckpt
*.log

# Manifests ARE committed (they are the protocol). Do not ignore manifests/.
.DS_Store
.idea/
.vscode/

# Smoke-test scratch (regenerated by tools/make_smoke_data.py)
_smoke_data/
_smoke_runs/
reports/
